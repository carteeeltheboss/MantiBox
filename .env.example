# MaintiDoc configuration template.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed
# (AGENTS.md NEVER #1). Every value below is read by src/maintidoc/config.py.
# Placeholders marked CHANGE-ME have no working default on purpose: the app
# refuses to start rather than run with a guessable secret.

# ---------------------------------------------------------------- application
MAINTIDOC_ENV=dev                     # dev | test | prod
MAINTIDOC_LOG_LEVEL=INFO
MAINTIDOC_SECRET_KEY=CHANGE-ME        # JWT signing key; >=32 chars in prod
MAINTIDOC_ACCESS_TOKEN_TTL_MINUTES=60
MAINTIDOC_MAX_UPLOAD_MEGABYTES=10

# ------------------------------------------------------------------ postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=maintidoc
POSTGRES_USER=maintidoc
POSTGRES_PASSWORD=CHANGE-ME

# -------------------------------------------------------------------- qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_TEXT_COLLECTION=maintidoc_text
QDRANT_IMAGE_COLLECTION=maintidoc_images

# --------------------------------------------------------------------- minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE-ME
MINIO_SECRET_KEY=CHANGE-ME
MINIO_BUCKET=maintidoc
MINIO_SECURE=false

# -------------------------------------------------------------------- mlflow
MLFLOW_TRACKING_URI=http://mlflow:5000
# Set to "null" to disable tracking (used by CI and the light dev install).
MAINTIDOC_TRACKING_BACKEND=auto       # auto | mlflow | null

# ------------------------------------------------- mcp maintenance service
MCP_SERVER_URL=http://mcp-server:8100/mcp
MCP_API_KEY=CHANGE-ME
MCP_MAX_CALLS_PER_REQUEST=3
MCP_REQUEST_TIMEOUT_SECONDS=10

# ----------------------------------------------------------------- inference
# Device selection is probed at runtime in the order CUDA -> MPS -> CPU.
# "auto" is the default; pin it only to reproduce a specific benchmark.
MAINTIDOC_DEVICE=auto                 # auto | cuda | mps | cpu
MAINTIDOC_VLM_PROVIDER=auto           # auto | qwen | stub
MAINTIDOC_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
MAINTIDOC_VLM_FALLBACK_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
MAINTIDOC_VLM_QUANTIZATION=awq
MAINTIDOC_VLM_MAX_NEW_TOKENS=512
MAINTIDOC_VLM_MAX_IMAGE_PIXELS=401408 # 512 * 28 * 28, Qwen2.5-VL patch grid
MAINTIDOC_VLM_MIN_VRAM_GB=5.0
MAINTIDOC_MAX_MODEL_CALLS=6
MAINTIDOC_REQUEST_BUDGET_SECONDS=60
# Off by default, deliberately. Qwen2.5-VL-7B is the model and a smaller one is
# never substituted: if the 7B does not fit, report and stop rather than quietly
# serve something else. Enabling this is an explicit recorded deviation (ADR 0003).
MAINTIDOC_ALLOW_MODEL_FALLBACK=false

MAINTIDOC_TEXT_EMBEDDING_MODEL=BAAI/bge-m3
MAINTIDOC_IMAGE_EMBEDDING_MODEL=clip-multilingual
MAINTIDOC_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MAINTIDOC_RERANKER_ADAPTER=           # path to a fine-tuned adapter, if any

# Hugging Face cache. Inside containers this is a mounted volume so weights
# survive a rebuild.
HF_HOME=/models
HF_HUB_OFFLINE=0

# ------------------------------------------------------------------ retrieval
MAINTIDOC_TOP_K_TEXT=20
MAINTIDOC_TOP_K_IMAGE=20
MAINTIDOC_RRF_K=60
MAINTIDOC_TOP_N_AFTER_FUSION=8
MAINTIDOC_MIN_RELEVANCE_SCORE=0.0
